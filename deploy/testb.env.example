# Deliberately unusable placeholders. Keep the real TestB environment outside Git.

# Every image reference must include @sha256:<64 lowercase hex> and must already
# be loaded on the host. The deployment Compose file has pull_policy: never.
PROVIDER_RUNTIME_IMAGE=registry.example.invalid/opensales-provider@sha256:__SET_64_HEX_DIGEST__
POSTGRES_IMAGE=registry.example.invalid/postgres@sha256:__SET_64_HEX_DIGEST__
CADDY_IMAGE=registry.example.invalid/caddy@sha256:__SET_64_HEX_DIGEST__

PROVIDER_BASE_URL=https://provider-lab.example.invalid
CORE_CALLBACK_URL=https://core-lab.example.invalid
PROVIDER_EDGE_BIND_ADDRESS=__SET_APPROVED_BIND_ADDRESS__
PROVIDER_HTTPS_PORT=443
PROVIDER_TLS_CERT_FILE=__SET_PRIVATE_ABSOLUTE_CERTIFICATE_PATH__
PROVIDER_TLS_KEY_FILE=__SET_PRIVATE_ABSOLUTE_KEY_PATH__
PAYMENT_DATABASE_HOST_PORT=55433
PROVISIONING_DATABASE_HOST_PORT=55434
MAIL_DATABASE_HOST_PORT=55435
PLATFORM_DATABASE_HOST_PORT=55436

PAYMENT_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_PAYMENT_DATABASE_PASSWORD__
PROVISIONING_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_PROVISIONING_DATABASE_PASSWORD__
MAIL_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_MAIL_DATABASE_PASSWORD__
PROVIDER_PLATFORM_DATABASE_PASSWORD=__GENERATE_UNIQUE_PLATFORM_DATABASE_PASSWORD__
MOCK_PAYMENT_PROVIDER_TOKEN=__GENERATE_SHARED_PAYMENT_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVISIONING_PROVIDER_TOKEN=__GENERATE_SHARED_PROVISIONING_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_MAIL_PROVIDER_TOKEN=__GENERATE_SHARED_MAIL_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVIDER_PLATFORM_TOKEN=__GENERATE_SHARED_PLATFORM_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVIDER_REQUEST_FINGERPRINT_KEY=__GENERATE_EXACTLY_32_BYTES_AS_BASE64URL__
MOCK_PROVIDER_REQUEST_FINGERPRINT_KEY_VERSION=1
# Empty initially. Retain every used version:key entry for this Provider database and its backups (32 versions maximum).
MOCK_PROVIDER_REQUEST_FINGERPRINT_PREVIOUS_KEYS=
LAB_MAILBOX_TOKEN=__GENERATE_SHARED_MAILBOX_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PAYMENT_WEBHOOK_SECRET=__GENERATE_SHARED_PAYMENT_WEBHOOK_SECRET__
MOCK_PROVISIONING_WEBHOOK_SECRET=__GENERATE_SHARED_PROVISIONING_WEBHOOK_SECRET__

# Resource and local Docker-log bounds for the dedicated 4-vCPU / 8-GiB lab host.
PROVIDER_DATABASE_MEMORY_LIMIT=768m
PROVIDER_MEMORY_LIMIT=512m
EDGE_MEMORY_LIMIT=256m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3

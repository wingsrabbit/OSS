:8081 {
	@payment path /api/v1/provider-events/payment /api/v1/provider-events/refund /api/v1/provider-events/add-funds-chargeback
	handle @payment {
		reverse_proxy api:3000
	}

	@provisioning path /api/v1/provider-events/provisioning /api/v1/provider-events/resource-action /api/v1/provider-events/resource-termination
	handle @provisioning {
		reverse_proxy api:3000
	}

	handle {
		respond 404
	}
}

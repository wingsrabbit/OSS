# Deliberately unusable placeholders. Keep the real TestA environment outside Git.

# Every image reference must include @sha256:<64 lowercase hex> and must already
# be loaded on the host. The deployment Compose file has pull_policy: never.
CORE_RUNTIME_IMAGE=registry.example.invalid/opensales-core@sha256:__SET_64_HEX_DIGEST__
WEB_RUNTIME_IMAGE=registry.example.invalid/opensales-web@sha256:__SET_64_HEX_DIGEST__
POSTGRES_IMAGE=registry.example.invalid/postgres@sha256:__SET_64_HEX_DIGEST__
CADDY_IMAGE=registry.example.invalid/caddy@sha256:__SET_64_HEX_DIGEST__

CORE_PUBLIC_URL=https://core-lab.example.invalid
PROVIDER_BASE_URL=https://provider-lab.example.invalid
CORE_EDGE_BIND_ADDRESS=__SET_APPROVED_BIND_ADDRESS__
CORE_HTTPS_PORT=443
CORE_TLS_CERT_FILE=__SET_PRIVATE_ABSOLUTE_CERTIFICATE_PATH__
CORE_TLS_KEY_FILE=__SET_PRIVATE_ABSOLUTE_KEY_PATH__
CORE_DATABASE_HOST_PORT=55432

CORE_DATABASE_MIGRATOR_PASSWORD=__GENERATE_UNIQUE_MIGRATOR_DATABASE_PASSWORD__
CORE_DATABASE_API_PASSWORD=__GENERATE_UNIQUE_API_DATABASE_PASSWORD__
CORE_DATABASE_WORKER_PASSWORD=__GENERATE_UNIQUE_WORKER_DATABASE_PASSWORD__
MOCK_PAYMENT_PROVIDER_TOKEN=__GENERATE_SHARED_PAYMENT_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVISIONING_PROVIDER_TOKEN=__GENERATE_SHARED_PROVISIONING_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_MAIL_PROVIDER_TOKEN=__GENERATE_SHARED_MAIL_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVIDER_PLATFORM_TOKEN=__GENERATE_SHARED_PLATFORM_TOKEN_AT_LEAST_32_CHARACTERS__
LAB_MAILBOX_TOKEN=__GENERATE_SHARED_MAILBOX_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PAYMENT_WEBHOOK_SECRET=__GENERATE_SHARED_PAYMENT_WEBHOOK_SECRET__
MOCK_PROVISIONING_WEBHOOK_SECRET=__GENERATE_SHARED_PROVISIONING_WEBHOOK_SECRET__
PROVIDER_OPERATION_CAPABILITY_SECRET=__GENERATE_CORE_ONLY_OPERATION_CAPABILITY_SECRET__
PAYMENT_METHOD_TOKEN_KEY=__GENERATE_EXACTLY_32_BYTES_AS_BASE64URL__
PAYMENT_METHOD_TOKEN_LOOKUP_KEY=__GENERATE_A_DIFFERENT_32_BYTES_AS_BASE64URL__
IDENTITY_SECRET_KEY=__GENERATE_A_DIFFERENT_32_BYTES_AS_BASE64URL__

OSS_LOG_LEVEL=info
GLOBAL_RATE_LIMIT_MAX=120
NOTIFICATION_MAX_ATTEMPTS=3
LAB_MAILBOX_ENABLED=true
OSS_SCHEMA_ROLLBACK_BRIDGE=disabled
MOCK_PROVISION_SCENARIO=success
MOCK_RESOURCE_ACTION_SCENARIO=success
MOCK_SERVICE_OPERATION_SCENARIO=normal

# Resource and local Docker-log bounds for the dedicated 4-vCPU / 8-GiB lab host.
CORE_DATABASE_MEMORY_LIMIT=2g
API_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=1g
SEED_MEMORY_LIMIT=768m
WEB_MEMORY_LIMIT=256m
EDGE_MEMORY_LIMIT=256m
GATEWAY_MEMORY_LIMIT=256m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3

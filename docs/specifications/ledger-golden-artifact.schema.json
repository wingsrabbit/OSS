{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensales.system/schemas/ledger-golden-artifact.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OpenSales System exact-ledger golden artifact",
  "description": "Strict input, expected-posting, and deterministic attestation records for oss-ledger-exact/v1.",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/expected" },
    { "$ref": "#/$defs/attestation" }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "maxLength": 96
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "atoms": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$",
      "maxLength": 256
    },
    "base": {
      "type": "object",
      "required": ["$schema", "kind", "protocol", "matrix_id"],
      "properties": {
        "$schema": {
          "const": "https://opensales.system/schemas/ledger-golden-artifact.schema.json"
        },
        "kind": {
          "enum": ["input", "expected", "attestation"]
        },
        "protocol": {
          "const": "oss-ledger-exact/v1"
        },
        "matrix_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "inputValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "asset_id", "atoms"],
      "properties": {
        "input_id": { "$ref": "#/$defs/stableId" },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "atoms": { "$ref": "#/$defs/atoms" }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_id", "asset_id", "atoms"],
      "properties": {
        "amount_id": { "$ref": "#/$defs/stableId" },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "atoms": { "$ref": "#/$defs/atoms" }
      }
    },
    "posting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "account_id", "side", "asset_id", "atoms"],
      "properties": {
        "line_id": { "$ref": "#/$defs/stableId" },
        "account_id": { "$ref": "#/$defs/stableId" },
        "side": { "enum": ["debit", "credit"] },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "atoms": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posting_rule_id", "postings"],
      "properties": {
        "posting_rule_id": { "$ref": "#/$defs/stableId" },
        "postings": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/posting" }
        }
      }
    },
    "balanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posting_rule_id",
        "asset_id",
        "debit_atoms",
        "credit_atoms",
        "balanced"
      ],
      "properties": {
        "posting_rule_id": { "$ref": "#/$defs/stableId" },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "debit_atoms": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        },
        "credit_atoms": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        },
        "balanced": { "const": true }
      }
    },
    "input": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "kind",
            "protocol",
            "matrix_id",
            "vector_id",
            "inputs",
            "evaluate_amount_ids",
            "posting_rule_ids"
          ],
          "properties": {
            "$schema": {},
            "kind": { "const": "input" },
            "protocol": {},
            "matrix_id": {},
            "vector_id": { "$ref": "#/$defs/stableId" },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/inputValue" }
            },
            "evaluate_amount_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/stableId" }
            },
            "posting_rule_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/stableId" }
            }
          }
        }
      ]
    },
    "expected": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "kind",
            "protocol",
            "matrix_id",
            "vector_id",
            "amounts",
            "journals"
          ],
          "properties": {
            "$schema": {},
            "kind": { "const": "expected" },
            "protocol": {},
            "matrix_id": {},
            "vector_id": { "$ref": "#/$defs/stableId" },
            "amounts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/amount" }
            },
            "journals": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/journal" }
            }
          }
        }
      ]
    },
    "vectorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "vector_digest",
        "input_digest",
        "expected_digest",
        "result",
        "amounts",
        "journals",
        "balance_checks"
      ],
      "properties": {
        "vector_id": { "$ref": "#/$defs/stableId" },
        "vector_digest": { "$ref": "#/$defs/digest" },
        "input_digest": { "$ref": "#/$defs/digest" },
        "expected_digest": { "$ref": "#/$defs/digest" },
        "result": { "const": "passed" },
        "amounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/amount" }
        },
        "journals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/journal" }
        },
        "balance_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/balanceCheck" }
        }
      }
    },
    "attestation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "kind",
            "protocol",
            "matrix_id",
            "matrix_semantic_digest",
            "runner_digest",
            "vectors",
            "summary"
          ],
          "properties": {
            "$schema": {},
            "kind": { "const": "attestation" },
            "protocol": {},
            "matrix_id": {},
            "matrix_semantic_digest": { "$ref": "#/$defs/digest" },
            "runner_digest": { "$ref": "#/$defs/digest" },
            "vectors": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/vectorResult" }
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "passed", "failed"],
              "properties": {
                "total": { "type": "integer", "minimum": 1 },
                "passed": { "type": "integer", "minimum": 1 },
                "failed": { "const": 0 }
              }
            }
          }
        }
      ]
    }
  }
}

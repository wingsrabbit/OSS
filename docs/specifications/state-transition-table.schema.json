{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-transition-table.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OpenSales System State Transition Table",
  "description": "Structural schema for an aggregate state machine, including legal and illegal transitions, guards, concurrency, events, and permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "table_id",
    "aggregate_id",
    "title",
    "version",
    "source_evidence_ids",
    "states",
    "commands",
    "transitions",
    "illegal_transitions",
    "invariants",
    "concurrency",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./state-transition-table.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "table_id": {
      "$ref": "#/$defs/stableId"
    },
    "aggregate_id": {
      "$ref": "#/$defs/stableId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ids": {
      "$ref": "#/$defs/idList"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      },
      "contains": {
        "type": "object",
        "properties": {
          "initial": {
            "const": true
          }
        },
        "required": ["initial"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "illegal_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/illegalTransition"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "concurrency": {
      "$ref": "#/$defs/concurrency"
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "maxLength": 96
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "name", "description", "initial", "terminal"],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "name",
        "description",
        "actor_types",
        "permission_ids",
        "step_up_required",
        "idempotency_required",
        "audit_required"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "maxLength": 96
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "actor_types": {
          "$ref": "#/$defs/idList"
        },
        "permission_ids": {
          "$ref": "#/$defs/idList"
        },
        "step_up_required": {
          "type": "boolean"
        },
        "idempotency_required": {
          "type": "boolean"
        },
        "audit_required": {
          "type": "boolean"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from_state_ids",
        "command_id",
        "to_state_id",
        "guard_ids",
        "permission_ids",
        "effects",
        "emitted_event_ids",
        "failure_outcomes",
        "concurrency_strategy",
        "evidence_ids",
        "test_ids"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/stableId"
        },
        "from_state_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "command_id": {
          "$ref": "#/$defs/stableId"
        },
        "to_state_id": {
          "$ref": "#/$defs/stableId"
        },
        "guard_ids": {
          "$ref": "#/$defs/idList"
        },
        "permission_ids": {
          "$ref": "#/$defs/idList"
        },
        "effects": {
          "$ref": "#/$defs/stringList"
        },
        "emitted_event_ids": {
          "$ref": "#/$defs/idList"
        },
        "failure_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/failureOutcome"
          }
        },
        "concurrency_strategy": {
          "$ref": "#/$defs/concurrencyStrategy"
        },
        "evidence_ids": {
          "$ref": "#/$defs/idList"
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "failureOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "result", "state_change_allowed"],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "state_change_allowed": {
          "type": "boolean"
        }
      }
    },
    "illegalTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "from_state_ids",
        "command_id",
        "reason",
        "expected_result",
        "test_ids"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/stableId"
        },
        "from_state_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "command_id": {
          "$ref": "#/$defs/stableId"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "scope", "test_ids"],
      "properties": {
        "invariant_id": {
          "$ref": "#/$defs/stableId"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "concurrencyStrategy": {
      "type": "string",
      "enum": [
        "none",
        "resource_version",
        "compare_and_set",
        "row_lock",
        "serialized_operation",
        "unique_constraint",
        "other"
      ]
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_strategy",
        "conflict_result",
        "idempotency_scope",
        "late_or_out_of_order_policy",
        "test_ids"
      ],
      "properties": {
        "default_strategy": {
          "$ref": "#/$defs/concurrencyStrategy"
        },
        "conflict_result": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_scope": {
          "type": "string",
          "minLength": 1
        },
        "late_or_out_of_order_policy": {
          "type": "string",
          "minLength": 1
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_role",
        "reviewer_roles",
        "independent_review",
        "status",
        "reproduction_commands",
        "artifact_refs"
      ],
      "properties": {
        "author_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_review": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed"]
        },
        "reproduction_commands": {
          "$ref": "#/$defs/stringList"
        },
        "artifact_refs": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "independent_review": {
                "const": true
              },
              "reproduction_commands": {
                "type": "array",
                "minItems": 1
              },
              "artifact_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

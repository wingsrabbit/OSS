{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-posting-matrix.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OpenSales System Ledger Posting Matrix",
  "description": "Structural schema for append-only double-entry posting rules, exact amount derivations, reversals, concurrency controls, invariants, and golden vectors. It requires declared debit and credit lines plus balance evidence, but JSON Schema does not prove that amount expressions balance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "matrix_id",
    "title",
    "version",
    "source_evidence_ids",
    "asset_registry_refs",
    "accounts",
    "rounding_rules",
    "derived_amounts",
    "posting_rules",
    "manual_command_rules",
    "invariants",
    "concurrency_controls",
    "golden_vector_refs",
    "golden_runner",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./ledger-posting-matrix.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "matrix_id": {
      "$ref": "#/$defs/stableId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ids": {
      "$ref": "#/$defs/idList"
    },
    "asset_registry_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accounts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/ledgerAccount"
      }
    },
    "rounding_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roundingRule"
      }
    },
    "derived_amounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedAmount"
      }
    },
    "posting_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/postingRule"
      }
    },
    "manual_command_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manualCommandRule"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "journal_balance"
          }
        },
        "required": ["kind"]
      },
      "minContains": 1
    },
    "concurrency_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concurrencyControl"
      }
    },
    "golden_vector_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/goldenVectorReference"
      },
      "uniqueItems": true
    },
    "golden_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "executable", "attestation"],
      "properties": {
        "protocol": {
          "const": "oss-ledger-exact/v1"
        },
        "executable": {
          "allOf": [
            { "$ref": "#/$defs/digestedArtifact" },
            {
              "type": "object",
              "properties": {
                "reference": { "const": "repo:tools/run-ledger-golden-vectors.mjs" }
              }
            }
          ]
        },
        "attestation": {
          "allOf": [
            { "$ref": "#/$defs/digestedArtifact" },
            {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string",
                  "pattern": "^repo:docs/reviews/[A-Za-z0-9._/@+-]+\\.json$"
                }
              }
            }
          ]
        }
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "maxLength": 96
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonPlaceholderDigest": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/digest"
        }
      ],
      "not": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+._-]*:0+$"
      }
    },
    "integerString": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$",
      "maxLength": 256
    },
    "nonNegativeIntegerString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 256
    },
    "positiveIntegerString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 256
    },
    "exactExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "input_id"],
          "properties": {
            "op": { "const": "input" },
            "input_id": { "$ref": "#/$defs/stableId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "amount_id"],
          "properties": {
            "op": { "const": "amount" },
            "amount_id": { "$ref": "#/$defs/stableId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "values"],
          "properties": {
            "op": { "const": "sum" },
            "values": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/exactExpression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "const": "subtract" },
            "left": { "$ref": "#/$defs/exactExpression" },
            "right": { "$ref": "#/$defs/exactExpression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "values"],
          "properties": {
            "op": { "enum": ["min", "max"] },
            "values": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/exactExpression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "const": "clamp_min_zero" },
            "value": { "$ref": "#/$defs/exactExpression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value", "numerator", "denominator", "rounding_rule_id"],
          "properties": {
            "op": { "const": "multiply_ratio_round" },
            "value": { "$ref": "#/$defs/exactExpression" },
            "numerator": { "$ref": "#/$defs/nonNegativeIntegerString" },
            "denominator": { "$ref": "#/$defs/positiveIntegerString" },
            "rounding_rule_id": { "$ref": "#/$defs/stableId" }
          }
        }
      ]
    },
    "digestedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "content_digest"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^repo:[A-Za-z0-9._/@+-]+$",
          "minLength": 6,
          "maxLength": 512
        },
        "content_digest": {
          "$ref": "#/$defs/nonPlaceholderDigest"
        }
      }
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ledgerAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "code", "name", "class", "normal_balance", "description"],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/stableId"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_.-]*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "class": {
          "type": "string",
          "enum": ["asset", "liability", "equity", "revenue", "expense", "contra"]
        },
        "normal_balance": {
          "type": "string",
          "enum": ["debit", "credit"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roundingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounding_rule_id", "description", "asset_exponent_source", "mode"],
      "properties": {
        "rounding_rule_id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "asset_exponent_source": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["half_up", "half_even", "down", "up", "asset_defined"]
        }
      }
    },
    "derivedAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_id",
        "name",
        "formula",
        "input_ids",
        "rounding_rule_id",
        "invariant_ids",
        "evidence_ids",
        "test_ids"
      ],
      "properties": {
        "amount_id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "formula": {
          "$ref": "#/$defs/exactExpression"
        },
        "input_ids": {
          "$ref": "#/$defs/idList"
        },
        "rounding_rule_id": {
          "$ref": "#/$defs/stableId"
        },
        "invariant_ids": {
          "$ref": "#/$defs/idList"
        },
        "evidence_ids": {
          "$ref": "#/$defs/idList"
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "postingLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "side", "account_id", "amount_id", "description"],
      "properties": {
        "line_id": {
          "$ref": "#/$defs/stableId"
        },
        "side": {
          "type": "string",
          "enum": ["debit", "credit"]
        },
        "account_id": {
          "$ref": "#/$defs/stableId"
        },
        "amount_id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dimension_expressions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reversalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "original_reference_required", "reason_required"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["compensating_journal", "linked_correction", "prohibited"]
        },
        "original_reference_required": {
          "type": "boolean"
        },
        "reason_required": {
          "type": "boolean"
        },
        "follow_up_posting_rule_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "postingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posting_rule_id",
        "event_id",
        "trigger_conditions",
        "amount_source_ids",
        "rounding_rule_id",
        "idempotency_key_expression",
        "lines",
        "reversal",
        "balance_invariant_ids",
        "evidence_ids",
        "test_ids"
      ],
      "properties": {
        "posting_rule_id": {
          "$ref": "#/$defs/stableId"
        },
        "event_id": {
          "$ref": "#/$defs/stableId"
        },
        "trigger_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amount_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "rounding_rule_id": {
          "$ref": "#/$defs/stableId"
        },
        "idempotency_key_expression": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/postingLine"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "side": { "const": "debit" }
                },
                "required": ["side"]
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "side": { "const": "credit" }
                },
                "required": ["side"]
              },
              "minContains": 1
            }
          ]
        },
        "reversal": {
          "$ref": "#/$defs/reversalRule"
        },
        "balance_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "$ref": "#/$defs/idList"
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "manualCommandRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "required_input_fields",
        "permitted_destination_types",
        "correction_strategy",
        "step_up_required",
        "audit_required",
        "evidence_ids",
        "test_ids"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/stableId"
        },
        "required_input_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permitted_destination_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "correction_strategy": {
          "type": "string",
          "enum": ["compensating_journal", "linked_correction"]
        },
        "step_up_required": {
          "type": "boolean"
        },
        "audit_required": {
          "type": "boolean",
          "const": true
        },
        "evidence_ids": {
          "$ref": "#/$defs/idList"
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "kind", "statement", "scope", "property_test_ids"],
      "properties": {
        "invariant_id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string",
          "enum": ["journal_balance", "rebuild_balance", "projection", "amount", "other"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "property_test_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "goldenVectorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "input_fixture_ref",
        "input_fixture_digest",
        "expected_postings_ref",
        "expected_postings_digest",
        "content_digest",
        "covered_posting_rule_ids",
        "expected_invariant_ids",
        "property_test_ids"
      ],
      "properties": {
        "vector_id": {
          "$ref": "#/$defs/stableId"
        },
        "input_fixture_ref": {
          "$ref": "#/$defs/reference"
        },
        "input_fixture_digest": {
          "$ref": "#/$defs/nonPlaceholderDigest"
        },
        "expected_postings_ref": {
          "$ref": "#/$defs/reference"
        },
        "expected_postings_digest": {
          "$ref": "#/$defs/nonPlaceholderDigest"
        },
        "content_digest": {
          "$ref": "#/$defs/nonPlaceholderDigest"
        },
        "covered_posting_rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "expected_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "property_test_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "concurrencyControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "scope",
        "strategy",
        "conflict_result",
        "idempotency_scope",
        "evidence_ids",
        "test_ids"
      ],
      "properties": {
        "control_id": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "enum": ["resource_version", "compare_and_set", "row_lock", "unique_constraint", "serialized_operation", "other"]
        },
        "conflict_result": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "$ref": "#/$defs/idList"
        },
        "test_ids": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_role",
        "reviewer_roles",
        "independent_review",
        "status",
        "reproduction_commands",
        "artifact_refs"
      ],
      "properties": {
        "author_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_review": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed"]
        },
        "reproduction_commands": {
          "$ref": "#/$defs/stringList"
        },
        "artifact_refs": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "independent_review": {
                "const": true
              },
              "reproduction_commands": {
                "type": "array",
                "minItems": 1
              },
              "artifact_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

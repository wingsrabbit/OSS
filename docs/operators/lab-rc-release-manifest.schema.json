{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensales.example.invalid/schemas/lab-rc-release-manifest-v1.json",
  "title": "OpenSales mock-only laboratory RC backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "warning",
    "status",
    "profile",
    "release",
    "consistency",
    "timing",
    "tools",
    "databases",
    "artifacts"
  ],
  "properties": {
    "format": { "const": "opensales-lab-rc-backup/v1" },
    "warning": { "const": "NOT FOR PRODUCTION — MOCK PROVIDERS ONLY" },
    "status": { "const": "complete" },
    "profile": { "enum": ["TestA", "TestB", "local"] },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "configurationVersion", "credentialSetVersion", "versionBindingSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "configurationVersion": { "$ref": "#/$defs/version" },
        "credentialSetVersion": { "$ref": "#/$defs/version" },
        "versionBindingSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorAssertion",
        "sideEffectsPausedAt",
        "workerDispatchPaused",
        "providerMutationPaused",
        "multiDatabaseCapture"
      ],
      "properties": {
        "operatorAssertion": { "const": "application writers were stopped before capture" },
        "sideEffectsPausedAt": { "type": "string", "format": "date-time" },
        "workerDispatchPaused": { "const": true },
        "providerMutationPaused": { "const": true },
        "multiDatabaseCapture": {
          "const": "ordered logical dumps inside the recorded capture window"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "elapsedMilliseconds"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "elapsedMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pgDump", "pgRestore", "psql", "age"],
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 240 },
        "pgDump": { "type": "string", "minLength": 1, "maxLength": 240 },
        "pgRestore": { "type": "string", "minLength": 1, "maxLength": 240 },
        "psql": { "type": "string", "minLength": 1, "maxLength": 240 },
        "age": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/database" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+@-]{0,127}$"
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^artifacts/[a-z0-9-]+[.](dump|bundle)[.]age$"
    },
    "schemaHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "versions"],
      "properties": {
        "kind": { "enum": ["migration-history", "table-inventory"] },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 }
        }
      }
    },
    "attachmentInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "totalBytes", "invalid"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "invalid": { "const": 0 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerProfile", "contents", "artifact", "serverVersionNumber", "schemaHistory"],
      "properties": {
        "id": {
          "enum": ["core", "provider-payment", "provider-provisioning", "provider-mail", "provider-platform"]
        },
        "ownerProfile": { "enum": ["TestA", "TestB"] },
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "artifact": { "$ref": "#/$defs/artifactPath" },
        "serverVersionNumber": { "type": "integer", "minimum": 180000, "maximum": 189999 },
        "schemaHistory": { "$ref": "#/$defs/schemaHistory" },
        "attachmentInventory": { "$ref": "#/$defs/attachmentInventory" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "core" } }, "required": ["id"] },
          "then": {
            "required": ["attachmentInventory"],
            "properties": {
              "ownerProfile": { "const": "TestA" },
              "attachmentInventory": { "$ref": "#/$defs/attachmentInventory" },
              "schemaHistory": {
                "type": "object",
                "properties": { "kind": { "const": "migration-history" } }
              }
            }
          },
          "else": {
            "not": { "required": ["attachmentInventory"] },
            "properties": {
              "ownerProfile": { "const": "TestB" },
              "schemaHistory": {
                "type": "object",
                "properties": { "kind": { "const": "table-inventory" } }
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "kind", "component", "encryption", "sha256", "bytes"],
      "properties": {
        "file": { "$ref": "#/$defs/artifactPath" },
        "kind": { "enum": ["postgresql-custom-dump", "configuration-credential-bundle"] },
        "component": { "type": "string", "minLength": 1, "maxLength": 80 },
        "encryption": { "const": "age-v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

# Deliberately unusable placeholders only. Generate unique laboratory values.

OSS_ENV=development
# Optional. Tests default to silent; other modes default to info.
# OSS_LOG_LEVEL=info
OSS_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
GLOBAL_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://oss_api:__GENERATE_UNIQUE_API_DATABASE_PASSWORD__@core-db:5432/oss
DATABASE_RUNTIME_ROLE=oss_api
# MIGRATION_DATABASE_URL and the two runtime role passwords belong only in the
# one-shot migration container. API and Worker must not receive them.
MIGRATION_DATABASE_URL=postgresql://oss_migrator:__GENERATE_UNIQUE_MIGRATOR_DATABASE_PASSWORD__@core-db:5432/oss
DATABASE_API_ROLE_PASSWORD=__GENERATE_UNIQUE_API_DATABASE_PASSWORD__
DATABASE_WORKER_ROLE_PASSWORD=__GENERATE_UNIQUE_WORKER_DATABASE_PASSWORD__
CORE_DATABASE_MIGRATOR_PASSWORD=__GENERATE_UNIQUE_MIGRATOR_DATABASE_PASSWORD__
CORE_DATABASE_API_PASSWORD=__GENERATE_UNIQUE_API_DATABASE_PASSWORD__
CORE_DATABASE_WORKER_PASSWORD=__GENERATE_UNIQUE_WORKER_DATABASE_PASSWORD__
PAYMENT_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_PAYMENT_DATABASE_PASSWORD__
PROVISIONING_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_PROVISIONING_DATABASE_PASSWORD__
MAIL_PROVIDER_DATABASE_PASSWORD=__GENERATE_UNIQUE_MAIL_DATABASE_PASSWORD__
MOCK_PAYMENT_PROVIDER_URL=http://provider-payment:4000
MOCK_PROVISIONING_PROVIDER_URL=http://provider-provisioning:4000
MOCK_MAIL_PROVIDER_URL=http://provider-mail:4000
MOCK_MAILBOX_URL=http://provider-mailbox:4000
CORE_INTERNAL_URL=http://api:3000
CORE_CALLBACK_URL=http://callback-gateway:8081
MOCK_PAYMENT_PROVIDER_TOKEN=__GENERATE_UNIQUE_PAYMENT_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_PROVISIONING_PROVIDER_TOKEN=__GENERATE_UNIQUE_PROVISIONING_TOKEN_AT_LEAST_32_CHARACTERS__
MOCK_MAIL_PROVIDER_TOKEN=__GENERATE_UNIQUE_MAIL_TOKEN_AT_LEAST_32_CHARACTERS__
LAB_MAILBOX_TOKEN=__GENERATE_UNIQUE_MAILBOX_TOKEN_AT_LEAST_32_CHARACTERS__
PROVIDER_OPERATION_CAPABILITY_SECRET=__GENERATE_CORE_ONLY_OPERATION_CAPABILITY_SECRET__
PAYMENT_METHOD_TOKEN_KEY=__GENERATE_EXACTLY_32_BYTES_AS_BASE64URL__
PAYMENT_METHOD_TOKEN_KEY_VERSION=1
# Empty initially. During rotation use comma-separated old version:key entries (never commit real keys).
PAYMENT_METHOD_TOKEN_PREVIOUS_KEYS=
PAYMENT_METHOD_TOKEN_LOOKUP_KEY=__GENERATE_A_DIFFERENT_32_BYTES_AS_BASE64URL__
PAYMENT_METHOD_TOKEN_LOOKUP_KEY_VERSION=1
# Empty initially. Retain old lookup keys until every saved token is rewrapped.
PAYMENT_METHOD_TOKEN_LOOKUP_PREVIOUS_KEYS=
# Leave disabled except during the rollback runbook matching the deployed bridge image.
OSS_SCHEMA_ROLLBACK_BRIDGE=disabled
MOCK_PAYMENT_WEBHOOK_SECRET=__GENERATE_UNIQUE_PAYMENT_WEBHOOK_SECRET__
MOCK_PROVISIONING_WEBHOOK_SECRET=__GENERATE_UNIQUE_PROVISIONING_WEBHOOK_SECRET__
MOCK_PROVISION_SCENARIO=success
MOCK_RESOURCE_ACTION_SCENARIO=success
LAB_MAILBOX_ENABLED=true
